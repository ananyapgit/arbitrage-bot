# .streamlit/secrets.toml
# COPY THIS CONTENT to your Streamlit Cloud Secrets Management area.
# DO NOT commit the actual secrets.toml file to GitHub.

ADMIN_PASSWORD = "change_this_to_a_strong_password"

# Optional: If you need these available to the Streamlit app specifically
# (Though usually these are env vars for the bot process, Streamlit might need them for dashboard display)
BOT_TOKEN = "your_telegram_bot_token"
TELEGRAM_CHAT_ID = "your_channel_id"
